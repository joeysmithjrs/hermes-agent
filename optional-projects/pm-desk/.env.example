# PM Desk — environment variable NAMES only. Never commit real values.
# Copy to `.env` and fill locally; `.env` is gitignored.

# --- Local store / artifacts -------------------------------------------------
# Directory holding the SQLite DB and content-addressed raw artifacts.
PM_DESK_HOME=./data

# --- Signal ingress (local only) ---------------------------------------------
# HMAC-SHA256 shared secret for the local ingress. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PM_DESK_INGRESS_SECRET=
# Bind address / port for the local ingress. Defaults to 127.0.0.1:8787.
PM_DESK_INGRESS_HOST=127.0.0.1
PM_DESK_INGRESS_PORT=8787

# --- Hermes dispatcher (opt-in, disabled by default) -------------------------
# Set to "1" to allow the ingress to shell out to the Hermes launcher.
# Leave unset/empty to keep the durable-outbox dispatcher (the safe default).
PM_DESK_DISPATCH_HERMES=
# Hermes CLI binary used by the opt-in launcher.
PM_DESK_HERMES_BIN=hermes
# What the launcher runs. With PM_DESK_HERMES_MODE=path (the default) this is a
# workflow FILE PATH; with mode=catalog it is a registered catalog id. Leave
# unset to use the workflow shipped in this package, resolved absolutely.
PM_DESK_HERMES_WORKFLOW=
PM_DESK_HERMES_MODE=path
# Set to "1" to append --dry-run: Hermes compiles the workflow and plans the
# ready set without spawning an agent. Costs nothing; use it to prove the wiring.
PM_DESK_HERMES_DRY_RUN=

# --- Browserbase (opt-in live source collection) -----------------------------
# Values live in /home/hermes/.hermes/.env on this host. Names only here.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_PROXIES=
BROWSERBASE_ADVANCED_STEALTH=

# --- Opt-in live test / smoke guards -----------------------------------------
# Set to "1" to allow tests under tests/live to make real network calls.
PM_DESK_LIVE=
